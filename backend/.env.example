# ALION backend configuration.
# Copy this file to `.env` (same directory) and fill in real values.
# Never commit `.env` and never expose these values to the frontend.

APP_NAME=ALION
APP_VERSION=1.0.0
DEBUG=false

# SQLite for development; swap for PostgreSQL later without code changes.
DATABASE_URL=sqlite:///./alion.db

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:4028,http://127.0.0.1:4028

# AI provider selection for /api/chat: mock | openai | gemini | anthropic
DEFAULT_AI_PROVIDER=mock

# AI provider API keys — SECRETS, backend-only. Leave blank if unused.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Local model server (future provider).
OLLAMA_URL=http://localhost:11434
